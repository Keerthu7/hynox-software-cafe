# Neon PostgreSQL connection string. Keep real values in Vercel Environment Variables.
DATABASE_URL=

# First-time Hynox team account. Set these in Vercel, deploy once, then remove
# HYNOX_ADMIN_PASSWORD after the initial account has been created.
HYNOX_ADMIN_PHONE=
HYNOX_ADMIN_PASSWORD=

# Meta app values. App ID and Embedded Signup configuration ID are identifiers;
# the app secret and token encryption key are secrets and must stay server-side.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
BILLDESK_WEB_URL=https://your-billdesk-domain.example
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# An approved utility template with a DOCUMENT header and three body variables:
# customer name, cafe name, and bill total. Create/approve this in WhatsApp Manager.
WHATSAPP_RECEIPT_TEMPLATE=
WHATSAPP_RECEIPT_TEMPLATE_LANGUAGE=en
